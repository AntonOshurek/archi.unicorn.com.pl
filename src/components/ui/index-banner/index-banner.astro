---
//ASTRO
import { Image } from 'astro:assets';
//STYLES
import './index-banner.css';
//LIBS
import 'swiper/css';
import 'swiper/css/navigation';
import 'swiper/css/pagination';

const postImages: string[] = [
  'https://archi.unicorn.com.pl/img/projects/domy-blizniaki/domy-blizniaki_1.webp',
  'https://archi.unicorn.com.pl/img/projects/zabudowa-mieszkaniowa/zabudowa-mieszkaniowa_2.webp',
  'https://archi.unicorn.com.pl/img/projects/biurowiec-suchylas/realizacja/biurowiec-suchylas_realizacja_2.webp',
  'https://archi.unicorn.com.pl/img/projects/budynek-modulowy/budynek-modulowy_2.webp',
];
---

<!--<Image--><!--  class="index-banner"--><!--  src="https://archi.unicorn.com.pl/img/projects/domy-blizniaki/domy-blizniaki_1.webp"--><!--  alt="Dwa nowoczesne domy bliźniacze z drewnianą elewacją – jeden jasny, drugi ciemny, z wejściem pośrodku i małym drzewem przed budynkiem"--><!--  width={100}--><!--  height={100}--><!--/>-->
<div class="swiper">
  <!-- Additional required wrapper -->
  <div class="swiper-wrapper">
    <!-- Slides -->
    {
      postImages.map((imagePath) => (
        <div class="swiper-slide">
          <img class="post__image" src={imagePath} alt="" loading="lazy" />
        </div>
      ))
    }
  </div>

  <div class="swiper-button-prev"></div>
  <div class="swiper-button-next"></div>

  <div class="swiper-scrollbar"></div>
</div>

<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, Autoplay } from 'swiper/modules';

  const swiper = new Swiper('.swiper', {
    modules: [Navigation, Pagination, Autoplay],
    loop: true,
    speed: 1000,
    pagination: {
      el: '.swiper-pagination',
    },

    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },

    autoplay: {
      delay: 4000,
      disableOnInteraction: false,
    },
  });
</script>
