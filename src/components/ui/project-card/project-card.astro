---
import type { CollectionEntry } from 'astro:content';
//STYLES
import './project-card.css';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<article class="project-card">
  <div class="project-card__info-block">
    <h3 class="project-card__title">{project.data.title}</h3>
    <div class="project-card__info">
      <p>{project.data.location}</p>
      <p>{project.data.year}</p>
    </div>

    <a class="project-card__link" href=`projekty/${project.id}/index.html`></a>
  </div>

  <img
    class="project-card__image lazyload"
    loading="lazy"
    width="100"
    height="100"
    src={project.data.previewImagePath}
    alt={`${project.data.title} ${project.data.description}`}
  />
</article>
