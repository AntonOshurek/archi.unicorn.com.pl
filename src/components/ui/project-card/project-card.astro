---
import type { CollectionEntry } from 'astro:content';
//STYLES
import './project-card.css';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<article class="projects-card">
  <!--<a class="projects__link" href=`projekt/${project.slug}/index.html`> link</a>-->

  <div class="projects-card__info-block">
    <h3 class="projects-card__title">{project.data.title}</h3>
  </div>

  <img
    class="projects-card__image lazyload"
    loading="lazy"
    width="100"
    height="300"
    src={project.data.previewImagePath}
    alt={`${project.data.title} ${project.data.description}`}
  />
</article>
