---
import type { CollectionEntry } from 'astro:content';
//CONSTANTS
import { ROUTING } from '@shared/variables/routing';
//STYLES
import './project-card.css';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;

const base = import.meta.env.BASE_URL;
---

<article class="project-card">
  <div class="project-card__info-block">
    <h3 class="project-card__title">{project.data.title}</h3>
    <div class="project-card__info">
      <p>{project.data.location}</p>
      <p>{project.data.year}</p>
    </div>

    <a
      class="project-card__link"
      href={ROUTING.PROJECT.computedPath(project.id)}></a>
  </div>

  <img
    class="project-card__image lazyload"
    loading="lazy"
    width="100"
    height="100"
    src={project.data.previewImagePath}
    alt={`${project.data.title} ${project.data.description}`}
  />
</article>
