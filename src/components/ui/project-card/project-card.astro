---
import type { CollectionEntry } from 'astro:content';
//STYLES
import './project-card.css';
//VARIABLES
// import { ROUTING } from '@variables/routing';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<li class="projects__card">
  <a class="projects__link" href=`projekt/${project.slug}/index.html`>
    <div class="projects__info">
      <h3 class="projects__title">{project.data.title}</h3>
    </div>

    <img
      class="projects__image lazyload"
      loading="lazy"
      width="100"
      height="300"
      src={project.data.previewImagePath}
      alt="budynek retail parku, zieliony drzewa oraz spacerujące ludzie."
    />
  </a>
</li>
