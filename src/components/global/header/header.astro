---
//STYLES
import './styles.css';
//COMPONENTS
import Logo from '@components/ui/logo/logo.astro';
import OpenNavButton from '@components/global/nav/open-nav-button/open-nav-button.astro';
import Nav from '@components/global/nav/nav.astro';

interface Props {
  isFixed?: boolean;
  onlyDesktopFixed?: boolean;
}

const { isFixed, onlyDesktopFixed } = Astro.props;

const computedClasses = `${isFixed ? ' header--fixed' : ''}${onlyDesktopFixed ? ' header--only-desktop-fixed' : ''}`;
---

<header class=`header${computedClasses}`>
  <div class="header__wrap container">
    <div class="header__controls">
      <Logo />
      <OpenNavButton />
      <Nav />
    </div>
  </div>
</header>
