---
//STYLES
import './header.css';
//COMPONENTS
import Logo from '@components/ui/logo/logo.astro';
import OpenNavButton from '@components/global/nav/open-nav-button/open-nav-button.astro';
import Nav from '@components/global/nav/nav.astro';

interface Props {
  isFixed?: boolean;
}

const { isFixed } = Astro.props;

const computedClasses = `${isFixed ? ' header--fixed' : ''}`;
---

<header class=`header${computedClasses}`>
  <div class=`header__wrap ${isFixed ? 'container' : ''}`>
    <div class="header__controls">
      <Logo />
      <OpenNavButton />
      <Nav />
    </div>
  </div>
</header>
