---
//STYLES
import './nav.css';
//COMPONENTS
import Item from './item/item.astro';
//CONSTANTS
import { ROUTING } from '@shared/variables/routing';

const base = import.meta.env.BASE_URL;
---

<nav class="nav">
  <h2 class="visually-hidden">Nawigacja po stronie Unicorn arhitekte</h2>

  <ul class="nav__list">
    <Item title="Home" path={ROUTING.ROOT.path} />
    <Item title="Projekty" path={ROUTING.PROJECTS.path} />
    <Item title="Kontakt" path={ROUTING.CONTACT.path} />
  </ul>
</nav>
