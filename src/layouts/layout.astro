---
//STYLES
import '@styles/index.css';
import './layout.css';
//SEO
import Head from '@components/seo/head.astro';
//COMPONENTS
import Header from '@components/global/header/header.astro';

interface Props {
  metaTitle: string;
  metaDescription: string;
  keywords: string;
  metaImage: string;
  additionalBodyClass?: string;
  isHeaderFixed?: boolean;
  defaultLayout?: boolean;
}

const {
  metaTitle,
  metaDescription,
  keywords,
  metaImage,
  additionalBodyClass,
  isHeaderFixed,
  defaultLayout,
} = Astro.props;
---

<!doctype html>
<html lang="pl">
  <Head
    title={metaTitle}
    description={metaDescription}
    image={metaImage}
    keywords={keywords}
  />

  <body
    class=`body ${defaultLayout ? 'body--default-layout' : ''} ${additionalBodyClass ? additionalBodyClass : ''} ${isHeaderFixed ? 'body--fixed-header' : 'container'}`
  >
    <Header isFixed={isHeaderFixed} isDefaultBodyLayout={defaultLayout}>
      {!defaultLayout && <slot name="header-title" slot="title" />}
    </Header>

    {
      defaultLayout && (
        <div class="body__titles-block">
          <slot name="header-title" slot="title" />
        </div>
      )
    }

    <slot />
  </body>
</html>

<script>
  import '../scripts/email-links.ts';
</script>
