---
//STYLES
import '@styles/index.css';
import './layout.css';
//SEO
import Head from '@components/seo/head.astro';
//COMPONENTS
import Header from '@components/global/header/header.astro';

interface Props {
  metaTitle: string;
  metaDescription: string;
  keywords: string;
  metaImage: string;
  isHeaderFixed?: boolean;
  withTitle?: boolean;
  isIndexPage?: boolean;
}

const {
  metaTitle,
  metaDescription,
  keywords,
  metaImage,
  isHeaderFixed,
  withTitle = false,
  isIndexPage,
} = Astro.props;
---

<!doctype html>
<html lang="pl">
  <Head
    title={metaTitle}
    description={metaDescription}
    image={metaImage}
    keywords={keywords}
  />

  <body class=`body ${isIndexPage ? 'body--index-page' : 'container'}`>
    <Header isFixed={isHeaderFixed} />

    {
      withTitle && (
        <div class="body__titles-block">
          <slot name="header-title" slot="title" />
        </div>
      )
    }

    <slot />
  </body>
</html>

<script>
  import '../scripts/email-links.ts';
</script>
