---
//STYLES
import '@styles/index.css';
import './styles.css';
//SEO
import Head from '@components/seo/head.astro';

interface Props {
  metaTitle: string;
  metaDescription: string;
  keywords: string;
  metaImage: string;
  additionalBodyClass?: string;
  isHeaderFixed?: boolean;
}

const {
  metaTitle,
  metaDescription,
  additionalBodyClass,
  metaImage,
  keywords,
  isHeaderFixed,
} = Astro.props;
---

<!doctype html>
<html lang="pl">
  <Head
    title={metaTitle}
    description={metaDescription}
    image={metaImage}
    keywords={keywords}
  />

  <body class=`body ${additionalBodyClass ? additionalBodyClass : ''}`>
    <!--header-->
    <slot />
  </body>
</html>
