---
//STYLES
import '@styles/index.css';
import './styles.css';
//SEO
import Head from '@components/seo/head.astro';
//COMPONENTS
import Header from '@components/global/header/header.astro';

interface Props {
  metaTitle: string;
  metaDescription: string;
  keywords: string;
  metaImage: string;
  additionalBodyClass?: string;
  isHeaderFixed?: boolean;
}

const {
  metaTitle,
  metaDescription,
  keywords,
  metaImage,
  additionalBodyClass,
  isHeaderFixed,
} = Astro.props;
---

<!doctype html>
<html lang="pl">
  <Head
    title={metaTitle}
    description={metaDescription}
    image={metaImage}
    keywords={keywords}
  />

  <body
    class=`body ${additionalBodyClass ? additionalBodyClass : ''} ${isHeaderFixed ? 'body--fixed-header' : 'container'}`
  >
    <Header isFixed={isHeaderFixed} />
    <slot />
  </body>
</html>
