---
//STYLES
import '@styles/index.css';
//SEO
import Head from '@components/seo/head.astro';

interface Props {
  metaTitle: string;
  metaDescription: string;
  keywords: string;
  metaImage: string;
  additionalBodyClass?: string;
}

const { metaTitle, metaDescription, additionalBodyClass, metaImage, keywords } =
  Astro.props;
---

<!doctype html>
<html lang="pl">
  <Head
    title={metaTitle}
    description={metaDescription}
    image={metaImage}
    keywords={keywords}
  />

  <body>
    <slot />
  </body>
</html>
