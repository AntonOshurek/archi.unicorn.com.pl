---
import type { CollectionEntry } from 'astro:content';
//COMPONENTS
import ProjectGallery from '@components/ui/project-gallery/project-gallery.astro';
import ProjectOverview from '@components/ui/project-overview/project-overview.astro';
//STYLES
import './project.widget.css';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<div class="project-widget">
  <ProjectGallery project={project} />
  <ProjectOverview project={project} />
</div>
