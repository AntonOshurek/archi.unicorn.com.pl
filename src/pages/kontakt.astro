---
//LAYOUTS
import Layout from '@layouts/Layout.astro';
//WIDGETS
import ContactWidget from '@widgets/contact/contact.widget.astro';
//COMPONENTS
import HeaderTitle from '@components/ui/header-title/header-title.astro';
---

<Layout
  metaTitle="Kontakt UNICORN Architecture"
  metaDescription="Unicorn architektura - Poznań, adres firmy, informacja kontaktowa"
  metaImage=""
  keywords="unicorn, poznań, architektura, adres, kontakt"
>
  <HeaderTitle slot="header-title" isLink={false} title="Kontakt" />

  <main class="main main--basic">
    <ContactWidget />
  </main>
</Layout>
